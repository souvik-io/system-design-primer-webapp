# Where reading progress and flashcard history are kept:
#   browser   in this browser only (localStorage), no sign-in. The default.
#   supabase  sign in by email link and sync across devices. Needs the two values below.
# Copy this file to .env.local to change it.
VITE_PROGRESS_STORAGE=browser

# From your Supabase project (Project Settings > API). Only used when VITE_PROGRESS_STORAGE=supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The address the built site is served from, without a trailing slash. Used at build time for
# full links in llms.txt and the Markdown copies of each chapter, canonical links, and sitemap.xml.
# Leave it empty while the site isn't published.
SITE_URL=
