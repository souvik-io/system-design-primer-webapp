    {
      "dot": "cyan",
      "title": "Stage 1: Retrieval (<25ms)",
      "items": [
        "Two-Tower DNN maps user context and 1B items into 256-d embeddings",
        "Vector ANN search (HNSW) prunes 1B items to top 1,000 candidates"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stage 2: Ranking (<40ms)",
      "items": [
        "Hydrates hundreds of online/offline features from Redis/Feast store",
