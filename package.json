{
  "name": "system-design-primer-webapp",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "content": "node --disable-warning=ExperimentalWarning scripts/build-content.mjs",
    "verify-content": "node --disable-warning=ExperimentalWarning scripts/verify-content.mjs",
    "predev": "node --disable-warning=ExperimentalWarning scripts/build-content.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node --disable-warning=ExperimentalWarning scripts/build-content.mjs",
    "build": "tsc && vite build",
    "postbuild": "node --disable-warning=ExperimentalWarning scripts/build-llms.mjs",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.10",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4"
  }
}
